# [0.0.1 T7] specs/features/0.0.1-shell.md
# [0.0.4 T18 T27] specs/features/0.0.4-righttabs.md
# 메타데이터만 기본값을 소유하도록 접근자와 등록 목록을 함께 만들어요.
file(GLOB_RECURSE definitions CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/src/*.settings.json")
set(registry "[]")
set(registry_count 0)
foreach(path IN LISTS definitions)
    file(READ "${path}" json)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    string(JSON module GET "${json}" module)
    get_filename_component(filename "${path}" NAME)
    if(NOT filename STREQUAL "${module}.settings.json")
        message(FATAL_ERROR "설정 모듈과 파일 이름 불일치: ${path}")
    endif()
    set(header "// [0.0.1 T7] specs/features/0.0.1-shell.md\n#pragma once\n#include <kgc/app/settings/Settings.h>\n#include <QStringView>\n#include <QStringList>\n#include <functional>\nnamespace kgc::${module}::settings {\n")
    string(JSON count LENGTH "${json}" settings)
    # 반환형만 다른 fromString은 한 헤더에 두 개 둘 수 없어서, enum마다 <이름>FromString 하나만 만들어요.
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON entry GET "${json}" settings ${index})
        foreach(field id type default labelKey category)
            string(JSON ${field} GET "${entry}" ${field})
        endforeach()
        if(NOT id MATCHES "^${module}\\.[a-z][A-Za-z0-9]*$")
            message(FATAL_ERROR "설정 식별자 접두사 불일치: ${id}")
        endif()
        string(REGEX REPLACE "^[^.]+\\." "" name "${id}")
        string(SUBSTRING "${name}" 0 1 initial)
        string(TOUPPER "${initial}" initial)
        string(SUBSTRING "${name}" 1 -1 rest)
        set(title "${initial}${rest}")
        set(read "kgc::app::settings::Settings::instance().value(\"${id}\")")
        set(write "value")
        if(type STREQUAL "enum")
            string(JSON enum_count LENGTH "${entry}" enum)
            math(EXPR enum_last "${enum_count} - 1")
            set(values "")
            set(string_values "")
            set(to "")
            set(from "")
            foreach(e RANGE 0 ${enum_last})
                string(JSON value GET "${entry}" enum ${e})
                string(SUBSTRING "${value}" 0 1 upper)
                string(TOUPPER "${upper}" upper)
                string(SUBSTRING "${value}" 1 -1 tail)
                set(enum_name "${upper}${tail}")
                string(APPEND values "${enum_name},")
                string(APPEND string_values "QStringLiteral(\"${value}\"),")
                string(APPEND to "case ${title}::${enum_name}: return QStringLiteral(\"${value}\");\n")
                string(APPEND from "if (value == u\"${value}\") return ${title}::${enum_name};\n")
                if(value STREQUAL default)
                    set(fallback "${enum_name}")
                endif()
            endforeach()
            string(APPEND header "enum class ${title} { ${values} };\ninline QString toString(${title} value) { switch(value) { ${to} } return {}; }\ninline ${title} ${name}FromString(QStringView value) { ${from} return ${title}::${fallback}; }\n")
            string(APPEND header "inline QStringList ${name}Values() { return {${string_values}}; }\n")
            set(cpp_type "${title}")
            set(read "${name}FromString(${read}.toString())")
            set(write "toString(value)")
        elseif(type STREQUAL "bool")
            set(cpp_type bool)
            string(APPEND read ".toBool()")
        elseif(type STREQUAL "int")
            set(cpp_type int)
            string(APPEND read ".toInt()")
        elseif(type STREQUAL "double")
            set(cpp_type double)
            string(APPEND read ".toDouble()")
        elseif(type STREQUAL "string")
            set(cpp_type QString)
            string(APPEND read ".toString()")
        elseif(type STREQUAL "list<object>")
            set(cpp_type QVariantList)
            string(APPEND read ".toList()")
        else()
            message(FATAL_ERROR "지원하지 않는 설정 형식: ${type}")
        endif()
        if(type STREQUAL "int" OR type STREQUAL "double")
            foreach(bound min max)
                string(JSON limit ERROR_VARIABLE missing GET "${entry}" ${bound})
                if(NOT missing)
                    if(bound STREQUAL "min")
                        set(suffix Min)
                    else()
                        set(suffix Max)
                    endif()
                    string(APPEND header "inline ${cpp_type} ${name}${suffix}() { return ${limit}; }\n")
                endif()
            endforeach()
        endif()
        string(APPEND header "inline ${cpp_type} ${name}() { return ${read}; }\ninline bool set${title}(${cpp_type} value) { return kgc::app::settings::Settings::instance().setValue(\"${id}\", ${write}); }\ninline QMetaObject::Connection on${title}Changed(QObject* receiver, std::function<void(${cpp_type})> callback) {\nreturn QObject::connect(&kgc::app::settings::Settings::instance(), &kgc::app::settings::Settings::changed, receiver, [callback = std::move(callback)](const QString& id) { if (id == \"${id}\") callback(${name}()); });\n}\n")
        string(JSON registry SET "${registry}" ${registry_count} "${entry}")
        math(EXPR registry_count "${registry_count} + 1")
    endforeach()
    string(APPEND header "}\n")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/gen/${module}/kgc/${module}")
    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/gen/${module}/kgc/${module}/Settings.h" CONTENT "${header}" @ONLY)
endforeach()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/gen/kgc/app/settings")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/gen/kgc/app/settings/Registry.cpp" CONTENT
"// [0.0.1 T7] specs/features/0.0.1-shell.md
#include <kgc/app/settings/Settings.h>
#include <QJsonDocument>
namespace kgc::app::settings {
QJsonArray Settings::registry() { return QJsonDocument::fromJson(R\"kgc(${registry})kgc\").array(); }
}
" @ONLY)

# [0.0.2 T18 T21] specs/features/0.0.2-theme.md
# 소유 모듈을 링크할 때만 생성 접근자가 보이도록 경로를 나눠요.
function(kgc_use_settings target module)
    target_include_directories(${target} PUBLIC "${CMAKE_BINARY_DIR}/gen/${module}")
    target_link_libraries(${target} PUBLIC kgc_app_settings)
endfunction()
